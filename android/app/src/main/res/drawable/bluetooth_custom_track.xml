<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <shape android:dither="true" android:shape="rectangle" android:useLevel="false" android:visible="true">
            <gradient android:angle="270" android:endColor="#C8C8C8" android:startColor="#C8C8C8" />
            <corners android:radius="@dimen/dp_16" />
            <size android:width="@dimen/dp_18" android:height="@dimen/dp_13" />
        </shape>
    </item>

    <item android:state_checked="true">
        <shape android:dither="true" android:shape="rectangle" android:useLevel="false" android:visible="true">
            <gradient android:angle="270" android:endColor="#76EE59" android:startColor="#76EE59" />
            <corners android:radius="@dimen/dp_16" />
            <size android:width="@dimen/dp_18" android:height="@dimen/dp_13" />
        </shape>
    </item>

</selector>
