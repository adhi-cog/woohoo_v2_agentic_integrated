<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contacts_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_corners_white_transparent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/item_contact_family_image"
        android:layout_width="@dimen/dp_64"
        android:layout_height="@dimen/dp_64"
        android:layout_gravity="center"
        android:contentDescription="@string/hint_second_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_contact_default_48dp" />

    <TextView
        android:id="@+id/item_contact_family_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp_16"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@android:color/white"
        android:textSize="@dimen/sp_18" /><!--Porting changes-->

</LinearLayout>