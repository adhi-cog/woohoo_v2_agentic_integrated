<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_network_issue"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_90"
    android:visibility="gone"
    android:layout_alignParentBottom="true">

    <LinearLayout
        android:id="@+id/mute_view_holder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_90"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/mute_bar_background"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mute_text_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_10"
            android:gravity="center"
            android:singleLine="true"
            android:fontFamily="sans-serif-regular"
            android:text="@string/mute_bar_error_text_primary"
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/white" />

        <ImageView
            android:id="@+id/mute_icon"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"
            android:background="@drawable/bg_arrow_expand_more"
            android:backgroundTint="@color/white"
            android:src="@drawable/ic_drawable_unmute"
            app:tint="@color/red_brick" />

        <TextView
            android:id="@+id/mute_text_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:gravity="center"
            android:fontFamily="sans-serif-regular"
            android:text="@string/mute_bar_error_text_secondary"
            android:textColor="@color/white"
            android:singleLine="true"
            android:textSize="@dimen/text_size_normal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/network_view_holder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_90"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/listening_background"
        android:backgroundTint="@color/red"
        android:visibility="gone">

        <ImageView
            android:id="@+id/wifi_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_50"
            android:src="@drawable/ic_wifi_no_internet" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_36"
            android:layout_marginEnd="@dimen/dp_10"
            android:fontFamily="sans-serif-regular"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/dp_21" />

    </LinearLayout>

</FrameLayout>
