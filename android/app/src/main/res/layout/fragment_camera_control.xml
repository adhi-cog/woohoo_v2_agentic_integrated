<?xml version="1.0" encoding="utf-8"?>
<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/interceptor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary">

    <RelativeLayout
        android:id="@+id/fragment_camera_control_relative_layout_header"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">

        <ImageView
            android:id="@+id/camera_control_back_button"
            android:layout_width="?android:attr/actionBarSize"
            android:layout_height="?android:attr/actionBarSize"
            android:contentDescription="@string/hint_second_name"
            android:padding="@dimen/fragment_music_image_view_back_padding"
            android:src="@drawable/ic_back_arrow_white_48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-light"
            android:text="@string/camera_control"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/fragment_music_header_text_size" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/camera_preview"
        android:layout_width="@dimen/dp_300"
        android:layout_height="@dimen/dp_300"
        android:layout_centerInParent="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/dp_5"
        android:layout_marginRight="@dimen/dp_5"
        android:layout_marginBottom="@dimen/dp_10"
        android:orientation="horizontal"
        android:weightSum="10">

        <Button
            android:id="@+id/camera_control_left"
            style="@style/ButtonRectCurveStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_2"
            android:layout_weight="5"
            android:textSize="@dimen/sp_14"
            android:elevation="@dimen/dp_8"
            android:text="@string/left" />

        <Button
            android:id="@+id/camera_control_right"
            style="@style/ButtonRectCurveStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_2"
            android:layout_weight="5"
            android:textSize="@dimen/sp_14"
            android:elevation="@dimen/dp_8"
            android:text="@string/right" />
    </LinearLayout>

</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>