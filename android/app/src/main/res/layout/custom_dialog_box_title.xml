<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_13pt33"
    app:cardBackgroundColor="?tile_color_primary"
    app:cardCornerRadius="@dimen/dp_10pt66">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dp_40">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_53"
            android:layout_marginEnd="@dimen/dp_40"
            android:fontFamily="sans-serif"
            android:text="Title"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/subTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_73"
            android:layout_marginEnd="@dimen/dp_40"
            android:fontFamily="sans-serif"
            android:text="Title"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/title" />

        <EditText
            android:id="@+id/edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_90"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@drawable/bg_stroke_edit_text"
            android:fontFamily="sans-serif"
            android:hint="hint"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:paddingStart="@dimen/dp_26pt66"
            android:paddingTop="@dimen/dp_18pt6"
            android:paddingBottom="@dimen/dp_18pt6"
            android:textColor="@color/white"
            android:textColorHint="?tile_color_secondary"
            android:textSize="@dimen/sp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <Button
            android:id="@+id/button_positive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@drawable/button_background"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:text="positive"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_21"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/button_negative"
            app:layout_constraintTop_toBottomOf="@+id/edit_text" />

        <Button
            android:id="@+id/button_negative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_26"
            android:background="@drawable/bg_cancel_button"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:text="negative"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_21"
            android:visibility="visible"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/button_positive"
            app:layout_constraintTop_toBottomOf="@+id/edit_text" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>