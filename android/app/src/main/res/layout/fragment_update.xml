<?xml version="1.0" encoding="utf-8"?>
<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_update_input_interceptor_relative_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    tools:context=".ui.main.fragments.settings.update.UpdateFragment">

    <include
        android:id="@+id/fragment_update_common_toolbar_layout"
        layout="@layout/common_toolbar" />

    <RelativeLayout
        android:id="@+id/fragment_update_relative_layout_update_check"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/fragment_update_text_view_update_margin"
        android:background="@drawable/rounded_rectangle_white_transparent_devices"
        android:visibility="gone">

        <TextView
            android:id="@+id/fragment_update_text_view_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/fragment_update_string_update_check_1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/fragment_update_text_view_update_text_size" />

        <ProgressBar
            android:id="@+id/fragment_update_progress_bar"
            style="@style/Base.Widget.AppCompat.ProgressBar"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10.67dp"
            android:layout_toStartOf="@+id/fragment_update_text_view_update"
            android:indeterminate="true"
            android:visibility="gone" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/fragment_update_relative_layout_new_update"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/fragment_update_text_view_update"
        android:layout_below="@id/fragment_update_common_toolbar_layout"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fragment_update_relative_layout_new_update_margin_start_end"
            android:layout_marginTop="@dimen/fragment_update_relative_layout_new_update_margin_top"
            android:layout_marginEnd="@dimen/fragment_update_relative_layout_new_update_margin_start_end"
            android:orientation="vertical"
            android:padding="@dimen/fragment_update_relative_layout_new_update_padding"
            android:visibility="visible">

            <TextView
                android:id="@+id/fragment_update_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/fragment_update_string_new_updates"
                android:textColor="@android:color/white"
                android:textSize="@dimen/fragment_update_text_view_new_update_available_text_size" />

            <TextView
                android:id="@+id/fragment_update_text_view_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#ffadb7"
                android:textSize="@dimen/fragment_update_text_view_version_text_size" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/fragment_update_view_line_height"
                android:layout_marginTop="@dimen/fragment_update_view_margin_top_bottom"
                android:layout_marginBottom="@dimen/fragment_update_view_margin_top_bottom"
                android:background="@drawable/rounded_corners_white_transparent" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/fragment_update_text_view_change_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/fragment_update_text_view_change_log_text_size" />

            </ScrollView>

        </LinearLayout>

        <Button
            android:id="@+id/fragment_update_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="@dimen/margin_40dp"
            android:layout_marginRight="@dimen/margin_40dp"
            android:layout_marginBottom="32dp"
            android:background="@android:color/white"
            android:text="@string/UPDATE"
            android:textSize="20sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/fragment_update_relative_layout_update_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/fragment_update_common_toolbar_layout"
        android:layout_marginBottom="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/fragment_update_download_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_40dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="@dimen/margin_40dp"
            android:textColor="?text_color_tertiary"
            android:textSize="21sp" />

        <ProgressBar
            android:id="@+id/fragment_update_download_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/fragment_update_download_progress_text"
            android:layout_marginLeft="@dimen/margin_40dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="@dimen/margin_40dp" />

        <Button
            android:id="@+id/fragment_update_cancel_download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="@dimen/margin_40dp"
            android:layout_marginRight="@dimen/margin_40dp"
            android:background="@drawable/bg_rect_shape"
            android:text="@string/cancel"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/fragment_update_relative_layout_check_for_update"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/fragment_update_text_view_update"
        android:layout_below="@id/fragment_update_common_toolbar_layout"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fragment_update_simple_orb"
            android:layout_width="@dimen/orb_height"
            android:layout_height="@dimen/orb_height"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/fragment_update_simple_drawee_view_orb_animation_margin_top"
            android:src="@drawable/img_orb_static" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fragment_update_image_view_logo"
            android:layout_width="@dimen/fragment_update_image_view_logo_width"
            android:layout_height="@dimen/fragment_update_image_view_logo_height"
            android:layout_below="@id/fragment_update_simple_orb"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/fragment_update_image_view_logo_margin_top"
            app:srcCompat="@drawable/ic_woohoo_logo" />

        <TextView
            android:id="@+id/fragment_update_text_view_version_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragment_update_image_view_logo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/fragment_update_text_view_version_number_margin_top"
            android:fontFamily="sans-serif"
            android:textColor="@android:color/white"
            android:textSize="@dimen/fragment_update_text_view_version_number_text_size" />

    </RelativeLayout>

</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>
