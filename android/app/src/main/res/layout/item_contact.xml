<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_contact_linear_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_106"
    android:orientation="horizontal"
    android:paddingStart="@dimen/item_contact_linear_layout_padding_start_end"
    android:paddingTop="@dimen/item_contact_linear_layout_padding_top_bottom"
    android:paddingEnd="@dimen/item_contact_linear_layout_padding_start_end"
    android:paddingBottom="@dimen/item_contact_linear_layout_padding_top_bottom">

    <ImageView
        android:id="@+id/item_contact_image"
        android:layout_width="@dimen/item_contact_image_width_height"
        android:layout_height="@dimen/item_contact_image_width_height"
        android:layout_gravity="center"
        android:contentDescription="@string/hint_second_name"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/item_contact_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/item_contact_name_margin_start"
        android:fontFamily="sans-serif-light"
        android:gravity="start"
        android:textColor="@color/white"
        android:textSize="@dimen/item_contact_name_text_size" />

</LinearLayout>