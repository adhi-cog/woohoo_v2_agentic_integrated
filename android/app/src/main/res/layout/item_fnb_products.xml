<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_category"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_250"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:padding="@dimen/dp_4">

    <ImageView
        android:id="@+id/imgCategory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <RelativeLayout
        android:id="@+id/layout_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_4"
        android:layout_alignParentBottom="true"
        android:background="@color/black"
        android:alpha="0.6">
        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:gravity="center"
            android:textSize="@dimen/sp_16"
            tools:text="test"
            android:maxLines="2"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layout_name">

        <ImageView
            android:id="@+id/imgAddZeroCart"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_5"
            android:background="@drawable/ellipse_bg"
            android:src="@drawable/ic_add_black_24dp" />

        <LinearLayout
            android:padding="@dimen/dp_8"
            android:background="@color/white"
            android:id="@+id/layout_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_5"
            android:layout_marginBottom="@dimen/dp_8"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgMinus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_minus_red_icon" />

            <TextView
                android:id="@+id/txtQuantity"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:layout_marginLeft="@dimen/padding_10"
                android:gravity="center"
                android:textColor="?colorPrimary"
                android:textSize="@dimen/sp_24"
                android:textStyle="bold"
                tools:text="1" />

            <ImageView
                android:id="@+id/imgAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/padding_10"
                android:src="@drawable/ic_add_green_icon" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:visibility="gone"
        android:id="@+id/txt_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_10"
        android:layout_margin="@dimen/dp_4"
        android:padding="@dimen/dp_4"
        android:textColor="@color/white"
        android:text="@string/details"
        android:alpha="0.6"
        android:background="@color/black"/>

    <TextView
        android:id="@+id/txt_out_of_stock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/sp_10"
        android:layout_margin="@dimen/dp_4"
        android:padding="@dimen/dp_4"
        android:textColor="@color/white"
        android:text="@string/not_in_stock"
        android:alpha="0.6"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:visibility="gone"
        android:background="@color/black"/>
</RelativeLayout>
