<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relaivelayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_primary"
    tools:context=".ui.main.fragments.home.HomeFragment">

    <!--    <LinearLayout-->
    <!--        android:layout_width="match_parent"-->
    <!--        android:orientation="vertical"-->
    <!--        android:layout_height="wrap_content">-->

    <!--        <EditText-->
    <!--            android:id="@+id/edit"-->
    <!--            android:layout_width="match_parent"-->
    <!--            android:layout_height="80dp">-->

    <!--        </EditText>-->
    <!--        <Button-->
    <!--            android:layout_width="wrap_content"-->
    <!--            android:layout_height="wrap_content"-->
    <!--            android:text="click"-->
    <!--            android:id="@+id/click"></Button>-->
    <!--    </LinearLayout>-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <TextView
            android:id="@+id/version_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@android:color/white"
            android:gravity="end|top"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginEnd="@dimen/dp_5"
            android:text="V168"
            android:textSize="@dimen/sp_10" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5.5"
            android:gravity="center"
            android:orientation="vertical">

            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/orb_animation"
                android:layout_width="@dimen/orb_height"
                android:layout_height="@dimen/orb_height"
                android:layout_marginTop="@dimen/dp_10"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/hotel_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_10"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/dp_16"
                        android:paddingEnd="@dimen/dp_16">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/dp_16"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/hotel_logo"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/hotel_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-light"
                                android:maxLines="2"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/sp_22"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hotel_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-light"
                                android:textColor="@android:color/white"
                                android:textSize="@dimen/sp_16" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/hotel_logo"
                            android:layout_width="@dimen/dp_180"
                            android:layout_height="@dimen/dp_100"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_220_homebanner">

                        <ImageView
                            android:id="@+id/hotel_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:src="@drawable/hotel" />

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btn_intro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="@dimen/dp_20"
                            android:layout_marginStart="@dimen/dp_20"
                            android:elevation="@dimen/dp_20"
                            app:fabCustomSize="@dimen/dp_50"
                            app:maxImageSize="@dimen/dp_30"
                            android:src="@drawable/play_arrow_black" />
                    </RelativeLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginEnd="@dimen/dp_15"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-regular"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_20"
                    tools:text="Device Name" />

                <LinearLayout
                    android:id="@+id/ll_lang_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_device_name"
                    android:layout_marginTop="@dimen/dp_10"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_lang_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_background"
                        android:drawableEnd="@drawable/ic_chevron"
                        android:fontFamily="sans-serif-light"
                        android:padding="@dimen/dp_7"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_15"
                        tools:text="English" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/img_bluetooth"
                        android:layout_width="@dimen/dp_10"
                        android:layout_height="@dimen/dp_15"
                        android:layout_marginEnd="@dimen/dp_5"
                        android:scaleType="centerCrop" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/img_battery"
                        android:layout_width="@dimen/dp_14"
                        android:layout_height="@dimen/dp_21" />

                    <TextView
                        android:id="@+id/fragment_home_text_view_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_10"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_20" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>


        <RelativeLayout
            android:id="@+id/fragment_home_relative_layout_family_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal"
                android:padding="@dimen/dp_10"
                android:visibility="gone"
                android:weightSum="5">

                <include layout="@layout/layout_amadeus_reception" />

                <include layout="@layout/layout_amadeus_room_service" />

                <include layout="@layout/layout_amadeus_house_keeping" />

                <include layout="@layout/layout_amadeus_spa" />

                <include layout="@layout/layout_amadeus_call" />


            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_quick_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal"
                android:padding="@dimen/dp_10">

                <LinearLayout
                    android:id="@+id/ll_first_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_first_link"
                        style="@style/HomeScreenIcon"
                        android:contentDescription="@string/hint_second_name"
                        android:src="@drawable/ic_fnb_home" />

                    <TextView
                        android:id="@+id/txt_first_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/in_room_dining"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_second_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_second_link"
                        style="@style/HomeScreenIcon"
                        android:contentDescription="@string/hint_second_name"
                        android:src="@drawable/ic_feedback_home" />

                    <TextView
                        android:id="@+id/txt_second_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/feedback"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_third_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_third_link"
                        style="@style/HomeScreenIcon"
                        android:contentDescription="@string/hint_second_name"
                        android:src="@drawable/ic_qr_code" />

                    <TextView
                        android:id="@+id/txt_third_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/woohoo_mobile"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_forth_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_forth_link"
                        style="@style/HomeScreenIcon"
                        android:contentDescription="@string/hint_second_name"
                        android:src="@drawable/ic_dark_mode" />

                    <TextView
                        android:id="@+id/txt_forth_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/night_mode"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_fifth_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/img_fifth_link"
                        style="@style/HomeScreenIcon"
                        android:contentDescription="@string/hint_second_name"
                        android:src="@drawable/ic_reception" />

                    <TextView
                        android:id="@+id/txt_fifth_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/receptionist"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contacts_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/dp_10"
                android:visibility="gone" />


            <ProgressBar
                android:id="@+id/fragment_contacts_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:indeterminate="true"
                android:indeterminateTint="#FFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/fragment_contacts_text_view_no_family_members"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="@string/fragment_contacts_text_view_no_family_members"
                android:textColor="@color/white_20_opacity"
                android:textSize="@dimen/sp_25"
                android:visibility="gone" />

        </RelativeLayout>

        <View
            android:id="@+id/fragment_home_view_line_bottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:alpha="0.1"
            android:background="@color/white" />


        <!--        <include-->
        <!--            android:id="@+id/handle"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="0dp"-->
        <!--            android:layout_margin="@dimen/margin_normal"-->
        <!--            android:layout_weight="2.5"-->
        <!--            layout="@layout/top_fav_resycle" />-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_top_grid_one"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/dp_15"
            android:layout_marginBottom="@dimen/dp_5"
            android:layout_weight="2.5"
            android:overScrollMode="never" />


    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="@dimen/dp_30"
        tools:context="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- include bottom sheet -->
        <include
            android:id="@+id/home_bottom_sheet"
            layout="@layout/bottom_sheet" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_2"
        android:layout_alignParentBottom="true"
        android:background="@drawable/gradient_border_line" />
</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>
