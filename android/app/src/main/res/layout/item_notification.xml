<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_109"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notificationSRNo"
        android:layout_width="@dimen/sp_32"
        android:layout_height="@dimen/sp_32"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/dp_46"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8"
        android:background="@drawable/bg_circle_transparent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="1"
        android:textAlignment="center"
        android:textColor="?text_color_secondary"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_28"
        android:fontFamily="sans-serif-medium"
        android:text="@string/alarm"
        android:textColor="@color/white_b3_opacity"
        android:textSize="@dimen/sp_18"
        app:layout_constraintStart_toEndOf="@+id/notificationSRNo"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/notification_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_2"
        android:fontFamily="sans-serif-medium"
        android:text="10:00 am"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_24"
        app:layout_constraintStart_toEndOf="@+id/notificationSRNo"
        app:layout_constraintTop_toBottomOf="@+id/notification_title" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_114"
        android:background="@color/white_a1_opacity"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/divider_last_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="@color/white_a1_opacity"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>