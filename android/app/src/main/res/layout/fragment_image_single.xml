<?xml version="1.0" encoding="utf-8"?>
<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/interceptor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:focusable="true"
    android:clickable="true"
    tools:context=".ui.main.fragments.templates.image.single.ImageSingleFragment">

    <include
        android:id="@+id/fragment_settings_relative_layout_header"
        layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/fragment_settings_relative_layout_header"
        android:orientation="vertical"
        android:weightSum="3">

        <ImageView
            android:id="@+id/fragment_image_single_template_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/fragment_image_single_text_description"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/dp_15"
            android:layout_weight="1"
            android:maxLines="3"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_22" />

    </LinearLayout>

</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>