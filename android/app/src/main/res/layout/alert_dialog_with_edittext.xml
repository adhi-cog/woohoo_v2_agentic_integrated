<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dp_24"
    android:background="?tile_color_primary">

    <TextView
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/sp_18"
        android:text="@string/instructions_for_chef"/>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_top_10"
        android:alpha="0.4"
        android:background="@color/white"
         android:layout_below="@+id/txt_title"/>

    <EditText
        android:id="@+id/editText"
        style="@style/EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/orb_height"
        android:maxLines="4"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_below="@+id/view"
        android:gravity="top|left"
        android:alpha="0.8"
        android:hint="@string/enter_instruction"
        android:textSize="@dimen/sp_16"
        android:textColorHint="@color/white"
        android:textColor="@color/white"
        android:padding="@dimen/dp_8"
        android:background="@drawable/bg_backgroung_white_border"
        android:layout_marginBottom="@dimen/dp_24" />

    <TextView
        android:id="@+id/button_positive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/editText"
        android:padding="@dimen/dp_4"
        android:text="@string/done"
        android:textSize="@dimen/sp_18"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/button_negative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        android:layout_below="@+id/editText"
        android:layout_toLeftOf="@+id/button_positive"
        android:padding="@dimen/dp_4"
        android:textSize="@dimen/sp_18"
        android:layout_marginRight="@dimen/dp_50"
        android:text="@string/cancel"
        android:textColor="@color/white" />

</RelativeLayout>


