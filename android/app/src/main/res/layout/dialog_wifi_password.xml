<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_13pt33"
    app:cardBackgroundColor="?tile_color_primary"
    app:cardCornerRadius="@dimen/dp_10pt66">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dp_40">

        <TextView
            android:id="@+id/connecting_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_53"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/enter_wi_fi_password"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_32"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/network"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/connecting_status" />

        <TextView
            android:id="@+id/network_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_16"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/secured_wi_fi"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_24"
            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintTop_toBottomOf="@+id/connecting_status" />

        <EditText
            android:id="@+id/edit_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_53"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@drawable/bg_stroke_edit_text"
            android:fontFamily="sans-serif"
            android:hint="@string/enter_password_here"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="@dimen/dp_26pt66"
            android:paddingTop="@dimen/dp_18pt6"
            android:paddingEnd="@dimen/dp_75"
            android:paddingBottom="@dimen/dp_18pt6"
            android:textColor="@color/white"
            android:textColorHint="?tile_color_secondary"
            android:textSize="@dimen/sp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/network_name" />


        <ImageView
            android:id="@+id/password_toggle_button"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_8"
            android:padding="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/edit_password"
            app:layout_constraintEnd_toEndOf="@+id/edit_password"
            app:layout_constraintTop_toTopOf="@+id/edit_password"
            app:srcCompat="@drawable/ic_eye_icon_show" />

        <TextView
            android:id="@+id/wrong_password_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/wrong_password_try_again"
            android:textColor="#e86c8c"
            android:textSize="@dimen/sp_21"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_password" />

        <Button
            android:id="@+id/text_positive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@drawable/button_background"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:text="@string/join"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_21"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/button_cancel"
            app:layout_constraintTop_toBottomOf="@+id/wrong_password_alert" />

        <Button
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_26"
            android:background="@drawable/bg_cancel_button"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_21"
            android:visibility="visible"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/text_positive"
            app:layout_constraintTop_toBottomOf="@+id/wrong_password_alert" />


        <Button
            android:id="@+id/button_connecting_cancel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@drawable/bg_cancel_button"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_21"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/wrong_password_alert" />

        <Button
            android:id="@+id/forget"
            android:layout_width="@dimen/dp_201"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_26"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@drawable/button_background"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingTop="@dimen/dp_20"
            android:paddingBottom="@dimen/dp_20"
            android:text="@string/forget"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_21"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/wrong_password_alert" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
