<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_notification">

    <include
        android:id="@+id/fragment_notification_header"
        layout="@layout/common_toolbar" />

    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:layout_below="@+id/fragment_notification_header"
        android:layout_marginTop="@dimen/dp_40"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/dp_40"
        android:paddingEnd="@dimen/dp_10"
        android:text="@string/following_items_need_your_attention"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_21" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/info" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_above="@+id/textView2"
        android:background="#CC000000" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_93"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:gravity="center"
        android:text="@string/screen_saver_hint_text"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_21" />

</RelativeLayout>