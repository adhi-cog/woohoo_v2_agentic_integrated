<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_news_audio_relative_layout_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:orientation="vertical"
    android:padding="@dimen/dp_15">

    <androidx.cardview.widget.CardView
        android:id="@+id/fragment_news_audio_card_view_news"
        android:layout_width="@dimen/dp_428"
        android:layout_height="@dimen/dp_428"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/dp_40"
        app:cardCornerRadius="@dimen/dp_6"
        app:cardElevation="@dimen/dp_24">

        <ImageView
            android:layout_width="@dimen/dp_428"
            android:layout_height="@dimen/dp_428"
            android:src="@drawable/bg_npr" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/fragment_news_audio_text_view_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fragment_news_audio_card_view_news"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp_34pt67"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:text="@string/fragment_news_audio_text_view_news"
        android:textColor="@color/white"
        android:textSize="@dimen/fragment_news_audio_text_view_banner_text_size" />

    <TextView
        android:id="@+id/fragment_news_audio_text_view_short_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fragment_news_audio_text_view_banner"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp_10"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/npr"
        android:textColor="?text_color_tertiary"
        android:textSize="@dimen/sp_20" />

    <RelativeLayout
        android:id="@+id/fragment_news_audio_relative_layout_player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fragment_news_audio_text_view_short_banner"
        android:layout_marginTop="@dimen/dp_12">

        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/fragment_news_audio_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="0"
            android:progressBackgroundTint="@color/white_30_opacity"
            android:progressTint="@android:color/white"
            android:thumb="@null"
            android:thumbTint="@color/white" />

        <TextView
            android:id="@+id/fragment_news_audio_text_view_start_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/fragment_news_audio_seek_bar"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_marginTop="@dimen/dp_8"
            android:fontFamily="sans-serif"
            android:text="00:00"
            android:textColor="@color/white_20_opacity"
            android:textSize="@dimen/fragment_news_audio_text_view_start_duration_text_size" />

        <TextView
            android:id="@+id/fragment_news_audio_text_view_end_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/fragment_news_audio_seek_bar"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_15"
            android:fontFamily="sans-serif"
            android:text="XX:XX"
            android:textColor="@color/white_20_opacity"
            android:textSize="@dimen/fragment_news_audio_text_view_end_duration_text_size" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="@dimen/dp_105"
        android:layout_height="@dimen/dp_105"
        android:layout_below="@+id/fragment_news_audio_relative_layout_player_controls"
        android:layout_centerHorizontal="true"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/dp_12">

        <ImageView
            android:id="@+id/fragment_news_audio_image_view_play"
            android:layout_width="@dimen/dp_85pt33"
            android:layout_height="@dimen/dp_85pt33"
            android:layout_centerInParent="true"
            android:alpha="0.8"
            android:background="@drawable/ic_circle_transparent"
            android:contentDescription="@string/app_name"
            android:padding="@dimen/fragment_music_image_view_play_padding"
            android:src="@drawable/ic_pause_white_24dp" />

        <ProgressBar
            android:id="@+id/fragment_news_audio_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:visibility="gone" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/fragment_news_audio_simple_exo_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</RelativeLayout>
