<?xml version="1.0" encoding="utf-8"?>
<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/interceptor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:focusable="true"
    android:clickable="true"
    tools:context=".ui.main.fragments.templates.image.list.ImageListFragment">

    <include
        android:id="@+id/fragment_settings_relative_layout_header"
        layout="@layout/common_toolbar" />

    <com.sb.woohoo.custom.KKViewPager
        android:id="@+id/viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fragment_settings_relative_layout_header"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_80" />

</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>