<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#110A27"
    android:orientation="vertical"
    tools:context=".ui.main.fragments.relaxationmusic.RelaxationMusicFragment">

    <include
        android:id="@+id/common_toolbar"
        layout="@layout/common_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/dashboard_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingBottom="@dimen/dp_90">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_26"
                    android:layout_marginEnd="@dimen/dp_24"
                    android:text="@string/relaxation_music_dashboard_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/sp_36"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_10"
                    android:layout_marginEnd="@dimen/dp_24"
                    android:lineSpacingExtra="@dimen/dp_4"
                    android:text="@string/relaxation_music_dashboard_subtitle"
                    android:textColor="#D6C9D9"
                    android:textSize="@dimen/sp_18" />

                <LinearLayout
                    android:id="@+id/category_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_28"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/category_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingBottom="@dimen/dp_90"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/category_hero"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_210"
                    android:layout_marginStart="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginEnd="@dimen/dp_24"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_30">

                    <TextView
                        android:id="@+id/category_hero_kicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.18"
                        android:textColor="#55E6D0"
                        android:textSize="@dimen/sp_18"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/category_hero_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_36"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/track_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_34"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/dp_24"
                android:paddingEnd="@dimen/dp_24"
                android:paddingBottom="@dimen/dp_36">

                <com.sb.woohoo.ui.main.fragments.relaxationmusic.RelaxationDiscView
                    android:id="@+id/player_disc"
                    android:layout_width="@dimen/dp_320"
                    android:layout_height="@dimen/dp_320"
                    android:layout_marginTop="@dimen/dp_34" />

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_30"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/sp_34"
                    android:textStyle="bold"
                    tools:text="Moonlight Serenade" />

                <TextView
                    android:id="@+id/player_category"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:gravity="center"
                    android:letterSpacing="0.18"
                    android:textColor="#55E6D0"
                    android:textSize="@dimen/sp_18"
                    android:textStyle="bold"
                    tools:text="DEEP SLEEP" />

                <TextView
                    android:id="@+id/timer_remaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:gravity="center"
                    android:text="10:00"
                    android:textColor="#A99CB9"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/duration_selector"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_24"
                    android:background="@drawable/bg_relaxation_segmented"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_42"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/previous_track_button"
                        android:layout_width="@dimen/dp_72"
                        android:layout_height="@dimen/dp_72"
                        android:gravity="center"
                        android:text="I◁"
                        android:textColor="#F4DCE4"
                        android:textSize="@dimen/sp_30"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/play_pause_button"
                        android:layout_width="@dimen/dp_104"
                        android:layout_height="@dimen/dp_104"
                        android:layout_marginStart="@dimen/dp_22"
                        android:layout_marginEnd="@dimen/dp_22"
                        android:background="@drawable/bg_relaxation_play_button"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="#4A2430"
                        android:textSize="@dimen/sp_44"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/next_track_button"
                        android:layout_width="@dimen/dp_72"
                        android:layout_height="@dimen/dp_72"
                        android:gravity="center"
                        android:text="▷I"
                        android:textColor="#F4DCE4"
                        android:textSize="@dimen/sp_30"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/repeat_button"
                        android:layout_width="@dimen/dp_72"
                        android:layout_height="@dimen/dp_72"
                        android:gravity="center"
                        android:text="↻"
                        android:textColor="#55E6D0"
                        android:textSize="@dimen/sp_30"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_34"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#F4DCE4"
                        android:textSize="@dimen/sp_28"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/volume_seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:progressTint="#55E6D0"
                        android:thumbTint="#55E6D0" />

                    <TextView
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="#F4DCE4"
                        android:textSize="@dimen/sp_28"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/player_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_32"
                    android:gravity="center"
                    android:text="@string/relaxation_music_ready"
                    android:textColor="#756B87"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_78"
            android:layout_gravity="bottom"
            android:background="#1C1235"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bottom_nav_explore"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/relaxation_music_nav_explore"
                android:textColor="#FFA3B5"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bottom_nav_sleep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/relaxation_music_nav_sleep"
                android:textColor="#9D91AC"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bottom_nav_timer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/relaxation_music_nav_timer"
                android:textColor="#9D91AC"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bottom_nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/settings"
                android:textColor="#9D91AC"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
