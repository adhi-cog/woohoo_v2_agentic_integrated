<?xml version="1.0" encoding="utf-8"?>
<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/interceptor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg_gradient"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical">

    <include
        android:id="@+id/fragment_settings_relative_layout_header"
        layout="@layout/common_toolbar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fragment_settings_relative_layout_header"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16">


        <!--<Button
            android:id="@+id/btn_add_alarm_once"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:background="@drawable/rounded_corners_blue"
            android:minHeight="0dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="Add Alarm Once"
            android:textAllCaps="false"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btn_add_alarm_everyday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_corners_blue"
            android:layout_marginRight="10dp"
            android:minHeight="0dp"
            android:paddingBottom="8dp"
            android:layout_marginLeft="10dp"
            android:paddingTop="8dp"
            android:text="Add Alarm Everyday"
            android:textAllCaps="false"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btn_delete_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:background="@drawable/rounded_corners_blue"
            android:layout_marginRight="10dp"
            android:minHeight="0dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="Delete All"
            android:textAllCaps="false"
            android:textColor="@color/white"/>-->
        <com.sb.woohoo.custom.RecyclerViewEmptySupport
            android:id="@+id/alarm_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_10"
            android:background="@drawable/rounded_corners_blue"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/alarm_empty_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/dp_25"
                android:drawablePadding="@dimen/dp_25"
                android:text="@string/no_alarms_set"
                android:textColor="@android:color/white"
                android:textSize="@dimen/sp_20"
                android:visibility="visible" />

            <Button
                android:id="@+id/btn_add_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@drawable/button_rounded_corner_bg"
                android:minHeight="0dp"
                android:paddingLeft="@dimen/dp_48"
                android:paddingTop="@dimen/dp_16"
                android:paddingRight="@dimen/dp_48"
                android:paddingBottom="@dimen/dp_16"
                android:text="@string/add_one"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="@dimen/dp_50"
            android:layout_height="@dimen/dp_50"
            android:layout_centerInParent="true"
            android:indeterminate="true"
            android:indeterminateTint="@android:color/white" />

    </RelativeLayout>

</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>
