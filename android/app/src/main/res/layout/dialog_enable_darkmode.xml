<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/layout_product_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:padding="@dimen/dp_12">

            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/dp_40"
                android:text="@string/night_mode_activating"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_36" />

            <RelativeLayout
                android:id="@+id/layout_countdown"
                android:layout_width="@dimen/dp_300"
                android:layout_height="@dimen/dp_300"
                android:layout_below="@+id/txt_title"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/dp_60"
                android:layout_marginBottom="@dimen/dp_60">

            <TextView
                android:id="@+id/txt_title_countdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="5"
                android:textAlignment="center"
                android:layout_centerInParent="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_160"
                android:background="@drawable/background_countdown_circle"
                android:textStyle="bold" />
            </RelativeLayout>
            <TextView
                android:id="@+id/txt_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textSize="@dimen/sp_18"
                android:textColor="@color/white"
                android:layout_below="@+id/layout_countdown"
                android:background="@drawable/background_nightmode_cancel_btn"
                android:paddingLeft="@dimen/dp_80"
                android:paddingRight="@dimen/dp_80"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10"
                android:layout_centerHorizontal="true" />
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>



