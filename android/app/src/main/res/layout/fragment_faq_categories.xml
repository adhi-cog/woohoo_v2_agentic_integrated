<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_news_headline_relative_layout_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_primary"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <RelativeLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/common_toolbar_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_toolbar_parent_margin_top"
        android:paddingStart="@dimen/common_toolbar_padding_start_end"
        android:paddingTop="@dimen/common_toolbar_padding_top_bottom"
        android:paddingEnd="@dimen/common_toolbar_padding_start_end"
        android:paddingBottom="@dimen/common_toolbar_padding_top_bottom">

        <ImageView
            android:id="@+id/common_toolbar_back"
            android:layout_width="@dimen/common_toolbar_back_width_height"
            android:layout_height="@dimen/common_toolbar_back_width_height"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_16"
            android:src="@drawable/ic_back_arrow_new" />

        <TextView
            android:id="@+id/common_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/common_toolbar_back"
            android:layout_marginStart="@dimen/margin_40dp"
            android:textColor="@android:color/white"
            android:text="@string/faq"
            android:textSize="@dimen/common_toolbar_title_text_size" />

        <ImageView
            android:scaleType="fitCenter"
            android:id="@+id/hotel_logo"
            android:layout_width="@dimen/dp_180"
            android:layout_height="@dimen/dp_100"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/dp_38"/>

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_faq"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:layout_below="@+id/common_toolbar_parent"/>
</RelativeLayout>
