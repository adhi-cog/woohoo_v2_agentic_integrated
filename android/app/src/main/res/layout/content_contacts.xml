<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    tools:showIn="@layout/fragment_own_device">

    <TextView
        android:id="@+id/tv_titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_40"
        android:text="@string/your_woohoo_hubs"
        android:textColor="?text_color_tertiary"
        android:textSize="@dimen/sp_22"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tv_empty_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="@string/no_other_hubs_registered"
        android:textColor="?text_color_tertiary"
        android:textSize="@dimen/sp_22"
        android:visibility="gone" />

    <com.sb.woohoo.custom.RecyclerViewEmptySupport
        android:id="@+id/fragment_recycler_view_own_devices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_titleText"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        android:visibility="visible" />

    <ProgressBar
        android:id="@+id/fragment_own_device_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

</RelativeLayout>