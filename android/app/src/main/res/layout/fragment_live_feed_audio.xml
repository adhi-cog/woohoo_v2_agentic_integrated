<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_live_feed_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:clickable="true"
    android:focusable="true">

    <RelativeLayout
        android:id="@+id/sip_incoming_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/screen_bg_gradient"
        android:paddingStart="@dimen/dp_24"
        android:paddingTop="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_32"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sip_incoming_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sip_incoming_room_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="?text_color_primary"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                tools:text="ROOM1901" />

            <TextClock
                android:id="@+id/sip_incoming_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="hh:mm a"
                android:format24Hour="HH:mm"
                android:letterSpacing="0.06"
                android:textColor="@color/sip_header_muted"
                android:textSize="@dimen/sp_20"
                tools:text="08:42 AM" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sip_incoming_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/sip_incoming_header"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_48"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/dp_240"
                android:layout_height="@dimen/dp_240">

                <View
                    android:id="@+id/sip_incoming_ring_outer"
                    android:layout_width="@dimen/dp_220"
                    android:layout_height="@dimen/dp_220"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sip_incoming_ring_outer" />

                <View
                    android:id="@+id/sip_incoming_ring_middle"
                    android:layout_width="@dimen/dp_180"
                    android:layout_height="@dimen/dp_180"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sip_incoming_ring_middle" />

                <FrameLayout
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_sip_incoming_avatar_circle">

                    <ImageView
                        android:id="@+id/sip_incoming_avatar"
                        android:layout_width="@dimen/dp_64"
                        android:layout_height="@dimen/dp_64"
                        android:layout_gravity="center"
                        android:contentDescription="@string/call"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_bell_white" />

                </FrameLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/sip_incoming_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_40"
                android:textStyle="bold"
                tools:text="In-Room Dining" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/sip_incoming_status_dot"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:background="@drawable/bg_sip_status_dot" />

                <TextView
                    android:id="@+id/sip_incoming_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:letterSpacing="0.1"
                    android:text="@string/sip_incoming_status"
                    android:textAllCaps="true"
                    android:textColor="@color/sip_header_muted"
                    android:textSize="@dimen/sp_20" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sip_incoming_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/sip_incoming_accept_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_100"
                android:background="@drawable/bg_sip_accept_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/dp_32"
                android:paddingEnd="@dimen/dp_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/sip_accept_call"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_28"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="@dimen/dp_64"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_sip_accept_icon_circle">

                    <ImageView
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:layout_gravity="center"
                        android:contentDescription="@string/sip_accept_call"
                        android:src="@drawable/ic_phone_black_24dp" />

                </FrameLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/sip_incoming_decline_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_100"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@drawable/bg_sip_decline_button"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/dp_32"
                android:paddingEnd="@dimen/dp_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/sip_decline_call"
                    android:textColor="@color/sip_card_title"
                    android:textSize="@dimen/sp_28"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="@dimen/dp_64"
                    android:layout_height="@dimen/dp_64"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_sip_decline_icon_circle">

                    <ImageView
                        android:layout_width="@dimen/dp_28"
                        android:layout_height="@dimen/dp_28"
                        android:layout_gravity="center"
                        android:contentDescription="@string/sip_decline_call"
                        android:rotation="135"
                        android:src="@drawable/ic_phone_black_24dp" />

                </FrameLayout>

            </RelativeLayout>

            <TextView
                android:id="@+id/sip_incoming_voice_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_48"
                android:gravity="center"
                android:text="@string/sip_incoming_voice_hint"
                android:textColor="@color/sip_header_muted"
                android:textSize="@dimen/sp_20"
                android:textStyle="italic" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Layout that will be visible to user when dropping is under initialising  -->
    <RelativeLayout
        android:id="@+id/live_feed_connecting_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/person_image"
            android:layout_width="@dimen/dp_350"
            android:layout_height="@dimen/dp_350"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_48"
            android:background="?color_secondary"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/person_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/person_image"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_28"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_42" />

        <TextView
            android:id="@+id/person_number_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/person_text"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_8"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_24"
            android:visibility="gone" />

        <TextView
            android:id="@+id/connecting_time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/person_number_text"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/audio_initializing"
            android:textColor="?tile_color_secondary"
            android:textSize="@dimen/sp_26" />

        <LinearLayout
            android:id="@+id/live_feed_button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/dp_40"
            android:gravity="center">

            <ImageView
                android:id="@+id/live_feed_call"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginEnd="@dimen/dp_16"
                android:contentDescription="@string/hint_second_name"
                android:scaleType="fitXY"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_live_feed_accept_call" />

            <ImageView
                android:id="@+id/live_feed_end"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginStart="@dimen/dp_20"
                android:contentDescription="@string/hint_second_name"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_live_feed_reject_call" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Layout that will be visible to user when sync countdown ends  -->
    <RelativeLayout
        android:id="@+id/live_feed_connected_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/fragment_content_live_feed_audio"
            layout="@layout/content_live_feed_audio" />
    </RelativeLayout>
</RelativeLayout>
