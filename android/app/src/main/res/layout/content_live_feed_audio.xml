<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg_gradient"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/connected_call_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_24"
        android:paddingTop="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/connected_room_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="?text_color_primary"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            tools:text="ROOM1901" />

        <TextClock
            android:id="@+id/connected_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:letterSpacing="0.06"
            android:textColor="@color/sip_header_muted"
            android:textSize="@dimen/sp_20"
            tools:text="08:42 AM" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/connected_call_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/connected_call_header"
        android:layout_above="@id/connected_call_controls_panel"
        android:layout_marginTop="@dimen/dp_32"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24">

        <FrameLayout
            android:layout_width="@dimen/dp_220"
            android:layout_height="@dimen/dp_220">

            <View
                android:layout_width="@dimen/dp_220"
                android:layout_height="@dimen/dp_220"
                android:layout_gravity="center"
                android:background="@drawable/bg_sip_call_avatar_outer" />

            <View
                android:layout_width="@dimen/dp_200"
                android:layout_height="@dimen/dp_200"
                android:layout_gravity="center"
                android:background="@drawable/bg_sip_call_avatar_inner" />

            <ImageView
                android:id="@+id/person_image_call"
                android:layout_width="@dimen/dp_180"
                android:layout_height="@dimen/dp_180"
                android:layout_gravity="center"
                android:background="@drawable/bg_sip_call_avatar_frame"
                android:contentDescription="@string/app_name"
                android:padding="@dimen/dp_6"
                android:scaleType="centerCrop"
                tools:src="@drawable/contact_no_image" />

        </FrameLayout>

        <TextView
            android:id="@+id/person_name_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_40"
            android:textStyle="bold"
            tools:text="In-Room Dining" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:background="@drawable/bg_sip_status_dot" />

            <TextView
                android:id="@+id/connected_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:letterSpacing="0.1"
                android:text="@string/sip_call_connected_status"
                android:textAllCaps="true"
                android:textColor="@color/sip_greeting_accent"
                android:textSize="@dimen/sp_20" />

            <Chronometer
                android:id="@+id/connected_duration_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:format="%s"
                android:textColor="@color/sip_greeting_accent"
                android:textSize="@dimen/sp_28"
                android:textStyle="bold"
                tools:text="01:24" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/connected_waveform"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_20"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="58dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="34dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

            <View
                android:layout_width="4dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_sip_call_wave_bar" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_140"
                android:layout_marginEnd="@dimen/dp_12"
                android:layout_weight="1"
                android:background="@drawable/bg_sip_call_info_card">

                <View
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_sip_call_info_card_highlight" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_24">

                    <ImageView
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/ic_call"
                        android:tint="@color/sip_greeting_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:letterSpacing="0.06"
                        android:text="@string/sip_call_detail_primary_label"
                        android:textAllCaps="true"
                        android:textColor="@color/sip_greeting_accent"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/person_number_call"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_26"
                        android:textStyle="bold"
                        tools:text="4501" />

                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_140"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:background="@drawable/bg_sip_call_info_card">

                <View
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_sip_call_info_card_highlight" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_24">

                    <ImageView
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:src="@drawable/ic_sip_clock"
                        android:tint="@color/sip_greeting_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:letterSpacing="0.06"
                        android:text="@string/sip_call_detail_secondary_label"
                        android:textAllCaps="true"
                        android:textColor="@color/sip_greeting_accent"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/connected_secondary_detail_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/sp_26"
                        android:textStyle="bold"
                        tools:text="Audio Call" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/connected_call_controls_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_sip_call_controls_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_24"
        android:paddingTop="@dimen/dp_28"
        android:paddingEnd="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_drawer_volume_low"
                android:tint="@color/sip_header_muted" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/call_volume_seek_bar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:layout_marginEnd="@dimen/dp_20"
                android:layout_weight="1"
                android:progressDrawable="@drawable/bg_sip_call_volume_progress"
                android:splitTrack="false"
                android:thumb="@drawable/bg_sip_call_volume_thumb" />

            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_drawer_volume_high"
                android:tint="@color/sip_header_muted" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/mike_button_on"
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="@dimen/dp_90"
                    android:contentDescription="@string/mute"
                    android:src="@drawable/ic_drop_in_mic_on" />

                <ImageView
                    android:id="@+id/mike_button_off"
                    android:layout_width="@dimen/dp_90"
                    android:layout_height="@dimen/dp_90"
                    android:contentDescription="@string/unmute"
                    android:src="@drawable/ic_drop_in_mic_off"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:letterSpacing="0.08"
                    android:text="@string/mute"
                    android:textAllCaps="true"
                    android:textColor="@color/sip_header_muted"
                    android:textSize="@dimen/sp_20" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/end_button"
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"
                    android:contentDescription="@string/sip_end_call"
                    android:src="@drawable/ic_live_feed_reject_call" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:letterSpacing="0.08"
                    android:text="@string/sip_end_call"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/sp_20" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/dp_100"
                    android:layout_height="@dimen/dp_100">

                    <ImageView
                        android:id="@+id/drop_in_speaker"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_100"
                        android:contentDescription="@string/sip_speaker"
                        android:src="@drawable/ic_speaker_on" />

                    <ImageView
                        android:id="@+id/drop_in_speaker_off"
                        android:layout_width="@dimen/dp_100"
                        android:layout_height="@dimen/dp_100"
                        android:contentDescription="@string/sip_speaker"
                        android:src="@drawable/ic_speaker_off"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:letterSpacing="0.08"
                    android:text="@string/sip_speaker"
                    android:textAllCaps="true"
                    android:textColor="@color/sip_greeting_accent"
                    android:textSize="@dimen/sp_20" />

            </LinearLayout>

        </LinearLayout>

        <include
            android:id="@+id/view_dialer_in_call"
            layout="@layout/view_dialer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
