<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- Primary view  -->
   <!-- <com.twilio.video.VideoView
        android:id="@+id/primary_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:visibility="gone"/>-->

    <FrameLayout
        android:id="@+id/primary_video_view_agora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Action Buttons  -->

    <LinearLayout
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/live_feed_gradient"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/dp_10"
        android:visibility="visible"
        android:weightSum="10">


        <!--Show/hide Camera View of User-->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_240"
            android:layout_marginEnd="@dimen/dp_10"
            android:layout_weight="3">

            <!--Thumbnail for User's View-->
<!--            <com.twilio.video.VideoView-->
<!--                android:id="@+id/thumbnail_video_view"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="match_parent"-->
<!--                android:background="@drawable/live_feed_preview_bg"-->
<!--                android:visibility="gone"-->
<!--                app:mirror="true"-->
<!--                app:overlaySurface="true" />-->

            <FrameLayout
                android:id="@+id/thumbnail_video_view_agora"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/live_feed_preview_bg"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_cancel_video_upstream"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/live_feed_preview_bg"
                android:contentDescription="@string/front_camera_view"
                android:padding="@dimen/dp_60"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_video_off" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/state_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_weight="7"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_80"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:layout_weight="1.75">

                <ImageView
                    android:id="@+id/iv_video_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:visibility="visible"
                    app:srcCompat="@drawable/ic_video_on" />

                <ImageView
                    android:id="@+id/iv_video_off"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    app:srcCompat="@drawable/video_off" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_80"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:layout_weight="1.75">

                <ImageView
                    android:id="@+id/drop_in_speaker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/hint_second_name"
                    app:srcCompat="@drawable/ic_speaker_on" />

                <ImageView
                    android:id="@+id/drop_in_speaker_off"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/hint_second_name"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_speaker_off" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_80"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/dp_5"
                android:layout_marginEnd="@dimen/dp_5"
                android:layout_weight="1.75">

                <ImageView
                    android:id="@+id/mike_button_on"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/hint_second_name"
                    app:srcCompat="@drawable/ic_mic_on" />

                <ImageView
                    android:id="@+id/mike_button_off"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/hint_second_name"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_mic_off" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_80"
                android:layout_gravity="bottom"
                android:layout_marginLeft="@dimen/dp_5"
                android:layout_marginRight="@dimen/dp_5"
                android:layout_weight="1.75">

                <ImageView
                    android:id="@+id/end_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/hint_second_name"
                    app:srcCompat="@drawable/ic_live_feed_reject_call" />
            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/img_video_upstream"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:src="@drawable/ic_video_off"
        android:visibility="gone" />


</FrameLayout>
