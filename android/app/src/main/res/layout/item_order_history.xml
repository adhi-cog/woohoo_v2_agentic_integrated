<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginTop="@dimen/dp_10"
    android:layout_marginBottom="@dimen/dp_10"
    android:layout_marginStart="@dimen/dp_20"
    android:layout_marginEnd="@dimen/dp_20"
    android:background="@drawable/rounder_corners_purple_10dp"
    android:padding="@dimen/dp_15"
    android:id="@+id/layout_history_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/fragment_settings_relative_layout_header">

    <TextView
        android:paddingTop="@dimen/dp_5"
        android:textSize="@dimen/sp_18"
        android:id="@+id/tvOrderId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Order: #123"
        android:textColor="@color/white" />

    <TextView
        android:layout_below="@+id/tvOrderId"
        android:textSize="@dimen/sp_14"
        android:id="@+id/tvOrderDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Order: #123"
        android:textColor="@color/white" />

    <TextView
        android:layout_marginTop="@dimen/dp_2"
        android:padding="@dimen/dp_8"
        android:background="@drawable/rounded_corners_white_outline_dp_10"
        android:layout_alignParentEnd="true"
        android:textSize="@dimen/sp_18"
        android:gravity="end"
        android:id="@+id/tvOrderStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        tools:text="Pending" />

    <LinearLayout
        android:layout_marginTop="@dimen/dp_8"
        android:layout_below="@+id/tvOrderStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_marginTop="@dimen/dp_8"
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white_40_opacity" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"/>

        <View
            android:layout_marginBottom="@dimen/dp_10"
            android:layout_marginTop="@dimen/dp_10"
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white_40_opacity" />

        <LinearLayout
            android:layout_below="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textStyle="bold"
                android:textSize="@dimen/sp_20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="@string/order_history_total"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvTotalPrice"
                android:textStyle="bold"
                android:textSize="@dimen/sp_20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:layout_marginRight="@dimen/dp_4"
                tools:text="$ 289.00"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>