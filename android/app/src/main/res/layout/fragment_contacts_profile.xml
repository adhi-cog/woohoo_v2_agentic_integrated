<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/interceptor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_15"
    tools:context="com.sb.woohoo.ui.main.fragments.contactsprofile.ContactsProfileFragment">

    <include
        android:id="@+id/fragment_contacts_profile_toolbar"
        layout="@layout/common_toolbar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:layout_below="@id/fragment_contacts_profile_toolbar"
        android:gravity="center">

        <ImageView
            android:id="@+id/fragment_contacts_profile_image_view_contact"
            android:layout_width="@dimen/fragment_contacts_profile_image_view_contact_size"
            android:layout_height="@dimen/fragment_contacts_profile_image_view_contact_size"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/dp_10"
            android:contentDescription="@string/hint_second_name"
            android:src="@drawable/ic_all_contact_default_48dp" />

        <TextView
            android:id="@+id/fragment_contacts_profile_text_view_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragment_contacts_profile_image_view_contact"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/fragment_contacts_profile_text_view_contact_name_margin_top"
            android:layout_marginEnd="@dimen/margin_15dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="@dimen/fragment_contacts_profile_text_view_contact_name_text_size" />

        <TextView
            android:id="@+id/fragment_contacts_profile_text_view_contact_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fragment_contacts_profile_text_view_contact_name"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_15dp"
            android:layout_marginTop="@dimen/fragment_contacts_profile_text_view_contact_number_margin_top"
            android:layout_marginEnd="@dimen/margin_15dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/rounded_corners_white_transparency"
            android:textSize="@dimen/fragment_contacts_profile_text_view_contact_number_size" />

        <LinearLayout

            android:id="@+id/feedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="@dimen/margin_15dp"
            android:background="@drawable/bg_contact_profile_bottom_layout"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/rl_live_feed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_15">

                <ImageView
                    android:id="@+id/img_live_feed"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/margin_15dp"
                    android:contentDescription="@string/live_feed"
                    android:src="@drawable/ic_video" />

                <TextView
                    android:id="@+id/tv_live_feed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/img_live_feed"
                    android:fontFamily="sans-serif"
                    android:text="@string/live_feed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/tv_no_access"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/margin_15dp"
                    android:background="@drawable/bg_no_access"
                    android:padding="@dimen/dp_5"
                    android:text="@string/no_access"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/sp_18"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/margin_15dp"
                    android:background="@drawable/ic_right_arrow"
                    android:padding="@dimen/dp_5"
                    android:textColor="@android:color/white"
                    android:visibility="visible" />

            </RelativeLayout>

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="@dimen/dp_30"
                android:layout_marginRight="@dimen/dp_30"
                android:background="#422c88" />

            <RelativeLayout
                android:id="@+id/rl_audio_call_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/padding_15">

                <ImageView
                    android:id="@+id/img_video_call"
                    android:layout_width="@dimen/dp_23"
                    android:layout_height="@dimen/dp_23"
                    android:layout_centerVertical="true"
                    android:layout_margin="@dimen/margin_15dp"
                    android:contentDescription="@string/live_feed"
                    android:src="@drawable/ic_audio" />

                <TextView
                    android:id="@+id/tv_video_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/img_video_call"
                    android:fontFamily="sans-serif"
                    android:text="@string/audio_call"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="normal" />


                <TextView
                    android:id="@+id/tv_no_access_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/margin_15dp"
                    android:background="@drawable/bg_no_access"
                    android:padding="@dimen/dp_5"
                    android:text="@string/no_access"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/sp_18"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_arrow_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="@dimen/margin_15dp"
                    android:background="@drawable/ic_right_arrow"
                    android:padding="@dimen/dp_5"
                    android:textColor="@android:color/white"
                    android:visibility="visible" />

            </RelativeLayout>

        </LinearLayout>
    </RelativeLayout>


</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>