<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?color_secondary"
    android:paddingStart="@dimen/dp_40"
    android:paddingTop="@dimen/dp_28"
    android:paddingEnd="@dimen/dp_40">

    <TextView
        android:id="@+id/device_setting_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Name of the Device"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_21"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/device_settings_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:fontFamily="sans-serif"
        android:text="WooHoo 1"
        android:textColor="?text_color_secondary"
        android:textSize="@dimen/sp_14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_setting_name" />


    <TextView
        android:id="@+id/progress_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_2"
        android:fontFamily="sans-serif"
        android:text="@string/fetching_name"
        android:textColor="?text_color_secondary"
        android:textSize="@dimen/sp_14"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/progress_bar"
        app:layout_constraintTop_toBottomOf="@+id/device_setting_name" />


    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_6"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_setting_name" />

    <ImageView
        android:layout_width="@dimen/dp_53"
        android:layout_height="@dimen/dp_53"
        android:padding="@dimen/dp_12"
        android:src="@drawable/ic_device_setting_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_26"
        android:background="?divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/device_settings_content" />


</androidx.constraintlayout.widget.ConstraintLayout>