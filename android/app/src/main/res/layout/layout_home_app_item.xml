<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_fragment_home_item_app"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/dp_10"
    android:layout_weight="1"
    android:background="@drawable/rounded_corners_navy_transparent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/dp_28">

    <ImageView
        android:id="@+id/fragment_home_image_view_app_icon"
        android:layout_width="@dimen/icon_size_home"
        android:layout_height="@dimen/icon_size_home"
        android:scaleType="fitXY"
        android:layout_marginTop="@dimen/dp_minus_12"
        android:src="@drawable/amadeus" />

    <TextView
        android:id="@+id/fragment_home_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_15"
        android:fontFamily="sans-serif-light"
        android:text="@string/spotify"
        android:textColor="@android:color/white"
        android:textSize="@dimen/dp_17" />

</LinearLayout>