<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dining_restaurant"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/fragment_settings_relative_layout_header"
            layout="@layout/common_toolbar" />
    </FrameLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/confirmButton"
        android:layout_below="@id/layout_toolbar"
        android:padding="@dimen/dp_16">

        <ImageView
            android:id="@+id/iv_qr_scan"
            android:layout_width="300dp"
            android:layout_centerInParent="true"
            android:layout_height="300dp"
            android:contentDescription="QR Code Image"/>
        <TextView
            android:id="@+id/txt_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_qr_scan"
            android:textSize="@dimen/sp_18"
            android:layout_marginTop="@dimen/dp_16"
            android:gravity="center"
            android:textColor="@color/grey_restaurant_timing"
            android:text="Scan this QR code from you phone camera to proceed!" />

    </RelativeLayout>
    <Button
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_53"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dp_60"
        android:layout_marginEnd="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_60"
        android:background="@drawable/btn_colored_bg"
        android:text="Exit"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/sp_26"
        android:textStyle="bold"
        android:visibility="visible" />
</RelativeLayout>