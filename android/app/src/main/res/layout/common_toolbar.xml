<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/common_toolbar_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/common_toolbar_parent_margin_top"
    android:paddingStart="@dimen/common_toolbar_padding_start_end"
    android:paddingTop="@dimen/common_toolbar_padding_top_bottom"
    android:paddingEnd="@dimen/common_toolbar_padding_start_end"
    android:paddingBottom="@dimen/common_toolbar_padding_top_bottom">

    <ImageView
        android:id="@+id/common_toolbar_back"
        android:layout_width="@dimen/common_toolbar_back_width_height"
        android:layout_height="@dimen/common_toolbar_back_width_height"
        android:layout_centerVertical="true"
        android:contentDescription="@string/app_name"
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:src="@drawable/ic_back_arrow_new" />

    <TextView
        android:id="@+id/common_toolbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/common_toolbar_title_margin_start_end"
        android:layout_marginEnd="@dimen/common_toolbar_title_margin_start_end"
        android:fontFamily="sans-serif-light"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="@dimen/common_toolbar_title_text_size" />

    <ImageView
        android:id="@+id/common_toolbar_right_icon"
        android:layout_width="@dimen/common_toolbar_back_width_height"
        android:layout_height="@dimen/common_toolbar_back_width_height"
        android:layout_centerVertical="true"
        android:contentDescription="@string/app_name"
        android:paddingStart="@dimen/dp_12"
        android:paddingTop="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_16"
        android:visibility="gone"
        android:layout_alignParentEnd="true" />

</RelativeLayout>