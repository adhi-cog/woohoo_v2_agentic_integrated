<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_news_headline_relative_layout_parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorPrimary"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <include
        android:id="@+id/fragment_settings_relative_layout_header"
        layout="@layout/common_toolbar" />

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fragment_settings_relative_layout_header"
        android:layout_marginLeft="@dimen/dp_30"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_30">

        <ImageView
            android:id="@+id/qr_code"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_width="@dimen/dp_350"
            android:layout_height="@dimen/dp_350"
            android:scaleType="fitXY"
            android:background="#30FFFFFF"/>

        <TextView
            android:id="@+id/tv_qr_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_toolbar_title_margin_start_end"
            android:layout_marginEnd="@dimen/common_toolbar_title_margin_start_end"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/qr_code_to_access_food_beverage"
            android:textColor="@android:color/white"
            android:layout_marginTop="@dimen/dp_36"
            android:textSize="@dimen/sp_18" />
    </LinearLayout>

</RelativeLayout>