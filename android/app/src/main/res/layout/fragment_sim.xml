<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary">

    <include
        android:id="@+id/fragment_settings_relative_layout_header"
        layout="@layout/common_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_26"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/cellular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_28"
        android:text="@string/cellular_data"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragment_settings_relative_layout_header" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/cellular_switch"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_23"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_30"
        android:thumb="@drawable/customswitchselector"
        app:layout_constraintBottom_toTopOf="@+id/view1"
        app:layout_constraintEnd_toEndOf="parent"
        app:track="@drawable/custom_track" />

    <View
        android:id="@+id/view1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@color/white_20_opacity"
        app:layout_constraintTop_toBottomOf="@+id/cellular" />

    <TextView
        android:id="@+id/data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_28"
        android:text="@string/data_roaming"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view1" />


    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/data_roaming_switch"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_23"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_30"
        android:thumb="@drawable/customswitchselector"
        app:layout_constraintBottom_toTopOf="@+id/view2"
        app:layout_constraintEnd_toEndOf="parent"
        app:track="@drawable/custom_track" />

    <View
        android:id="@+id/view2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginStart="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginEnd="@dimen/dp_40"
        android:background="@color/white_20_opacity"
        app:layout_constraintTop_toBottomOf="@+id/data" />

    <RelativeLayout
        android:id="@+id/preferred_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view2">

        <TextView
            android:id="@+id/network_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/preferred_network_type"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_24" />

        <TextView
            android:id="@+id/network_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/network_type"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_3"
            android:text="@string/_4g_recommended"
            android:textColor="@color/light_grey_color"
            android:textSize="@dimen/sp_18" />

        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:paddingStart="@dimen/dp_19"
            android:paddingTop="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_18"
            android:paddingBottom="@dimen/dp_14"
            android:src="@drawable/ic_forward" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_below="@+id/network_name"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_28"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@color/white_20_opacity" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/access_point"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preferred_network">

        <TextView
            android:id="@+id/access_point_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/access_point_names"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_24" />

        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:paddingStart="@dimen/dp_19"
            android:paddingTop="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_18"
            android:paddingBottom="@dimen/dp_14"
            android:src="@drawable/ic_forward" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_below="@+id/access_point_text"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_28"
            android:layout_marginEnd="@dimen/dp_40"
            android:background="@color/white_20_opacity" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/network_operators"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/access_point">

        <TextView
            android:id="@+id/network_operators_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_28"
            android:text="@string/network_operators"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_24" />

        <TextView
            android:id="@+id/network_operators_content_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/network_operators_text"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_3"
            android:text="@string/choose_a_network_operator"
            android:textColor="?text_color_secondary"
            android:textSize="@dimen/sp_18" />

        <ImageView
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_40"
            android:paddingStart="@dimen/dp_19"
            android:paddingTop="@dimen/dp_14"
            android:paddingEnd="@dimen/dp_18"
            android:paddingBottom="@dimen/dp_14"
            android:src="@drawable/ic_forward" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_below="@+id/network_operators_content_text"
            android:layout_marginTop="@dimen/dp_28"
            android:background="@color/white_20_opacity" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>