<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/dp_20"
    android:layout_marginTop="@dimen/dp_10"
    android:layout_marginRight="@dimen/dp_20"
    android:background="@drawable/rounded_corners_navy_transparent">

    <ImageView
        android:id="@+id/covid_img"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_250"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/covid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:padding="@dimen/dp_10"
        android:text=""
        android:textColor="@android:color/white"
        android:textSize="@dimen/sp_15"
        app:layout_constraintTop_toBottomOf="@+id/covid_img" />

    <com.sb.woohoo.custom.smileyrating.SmileyRating
        android:id="@+id/ratingBar"
        android:layout_width="@dimen/dp_200"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/covid_text" />


    <EditText
        android:id="@+id/edit_comment"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:background="@drawable/bg_stroke_edit_text"
        android:hint="@string/enter_covid"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="2"
        android:layout_margin="@dimen/dp_10"
        android:paddingStart="@dimen/dp_15"
        android:paddingTop="@dimen/margin_15dp"
        android:paddingEnd="@dimen/dp_15"
        android:paddingBottom="@dimen/dp_15"
        android:textColor="@color/white_80_opacity"
        android:textSize="@dimen/sp_20"
        android:textColorHint="@color/white_80_opacity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ratingBar" />

</androidx.constraintlayout.widget.ConstraintLayout>
