<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/layout_quantity_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/padding_10"
        android:paddingTop="@dimen/padding_20dp"
        android:paddingRight="@dimen/padding_20dp"
        android:paddingLeft="@dimen/padding_20dp">

        <RelativeLayout
            android:id="@+id/rel_top_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_4"
                android:layout_toStartOf="@+id/tvCustomise"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                tools:text="Cuisine Name" />

            <TextView
                android:id="@+id/tvCustomise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_44"
                android:layout_toStartOf="@+id/container_add_remove"
                android:padding="@dimen/dp_6"
                android:text="@string/customise"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_14"
                tools:text="Customised" />

        <LinearLayout
            android:layout_marginTop="@dimen/dp_4"
            android:id="@+id/container_add_remove"
            android:layout_marginEnd="@dimen/dp_80"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:background="@color/white">

            <ImageView
                android:id="@+id/imgRemove"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_minus_red_icon" />

            <TextView
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_8"
                android:id="@+id/txtQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?colorPrimary"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                tools:text="1" />

            <ImageView
                android:id="@+id/imgAdd"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_add_green_icon" />
        </LinearLayout>

            <TextView
                android:id="@+id/txtPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_4"
                android:gravity="center"
                android:text="0000  "
                android:textColor="@color/white"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold" />

        </RelativeLayout>

        <TextView
            android:id="@+id/txtModifiers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rel_top_layout"
            android:layout_marginEnd="@dimen/dp_15"
            android:layout_toStartOf="@+id/tvCustomise"
            android:paddingBottom="@dimen/dp_10"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_12"
            tools:text="Name "
            android:visibility="gone"/>

        <RelativeLayout
            android:id="@+id/layout_place_order"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txtModifiers">

            <TextView
                android:id="@+id/txt_convinences_charges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/convience_fee"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_delivery_charges_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                android:visibility="gone"
                tools:text="0" />

            <TextView
                android:id="@+id/txt_service_charge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_convinences_charges"
                android:text="@string/service_charge_10"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_service_charge_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_convinences_charges"
                android:layout_alignParentEnd="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                android:visibility="gone"
                tools:text="0" />

            <TextView
                android:id="@+id/txt_gst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_service_charge"
                android:text="@string/gst"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_gst_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_service_charge"
                android:layout_alignParentEnd="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13"
                android:visibility="gone"
                tools:text="0" />
        </RelativeLayout>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/layout_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rel_top_layout"
            android:layout_marginTop="@dimen/padding_20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="left"
                android:textSize="@dimen/sp_14"
                android:text="@string/portion_size"
                android:textColor="@color/white"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="center"
                android:textSize="@dimen/sp_14"
                android:text="@string/cuisine"
                android:textColor="@color/white"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:textSize="@dimen/sp_14"
                android:gravity="center"
                android:text="@string/instructions_for_chef"
                android:textColor="@color/white"
                android:textAllCaps="true" />
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/layout_instructions_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layout_instructions"
            android:layout_marginTop="@dimen/padding_10"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:gravity="center"
                android:textSize="@dimen/sp_12"
                android:text="@string/full"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:textSize="@dimen/sp_12"
                android:gravity="center"
                android:text="@string/Italian"
                android:textColor="@color/white"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/txtInstructions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:textSize="@dimen/sp_12"
                android:padding="@dimen/dp_4"
                android:gravity="left"
                android:maxLines="2"
                android:backgroundTint="?colorPrimaryDark"
                android:background="@drawable/bg_primary_color_border_trans_solid"
                android:textColor="@color/white" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white"
        android:alpha="0.4"
        android:layout_below="@+id/layout_quantity_price" />

</RelativeLayout>
