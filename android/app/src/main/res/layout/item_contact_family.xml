<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contacts_layout"
    android:layout_width="@dimen/item_contact_family_parent_size_width_height"
    android:layout_height="@dimen/item_contact_family_parent_size_width_height"
    android:layout_marginEnd="@dimen/item_contact_family_parent_margin_end"
    android:background="@drawable/rounded_corners_white_transparent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/item_contact_family_image"
        android:layout_width="@dimen/item_contact_family_image_width_height"
        android:layout_height="@dimen/item_contact_family_image_width_height"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/item_contact_family_image_margin_top"
        android:contentDescription="@string/hint_second_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_contact_default_48dp" />

    <TextView
        android:id="@+id/item_contact_family_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/item_contact_family_name_margin_start_end"
        android:layout_marginTop="@dimen/item_contact_family_name_margin_top"
        android:layout_marginEnd="@dimen/item_contact_family_name_margin_start_end"
        android:layout_marginBottom="@dimen/item_contact_family_name_margin_bottom"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="@dimen/item_contact_family_name_text_size" />

</LinearLayout>