<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/interceptor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:focusable="true"
    android:clickable="true"
    android:orientation="vertical"
   >

    <include
        android:id="@+id/fragment_to_do_toolbar"
        layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@+id/fragment_to_do_toolbar"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/dp_10"
            android:orientation="vertical"
            android:layout_weight="1"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/img_source"
                    android:layout_width="wrap_content"
                    android:background="@drawable/ic_speaker_on"
                    android:layout_height="wrap_content">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/lang_1"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:textSize="@dimen/sp_22"
                    android:layout_height="wrap_content">

                </TextView>

                <Spinner
                    android:layout_gravity="center_vertical"
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:outlineAmbientShadowColor="@color/white"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
            <EditText
                android:id="@+id/et_source"
                android:layout_width="match_parent"
                android:hint="@string/enter_text"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/dp_10"
                android:padding="@dimen/dp_10"
                android:gravity="left|top"
                android:background="@drawable/bg_background_edittext_select"
                android:layout_height="match_parent">

            </EditText>

        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_10"
            android:layout_height="1dp">
        </View>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/dp_10"
            android:layout_weight="1"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="wrap_content"
                    android:background="@drawable/ic_speaker_on"
                    android:layout_height="wrap_content">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="@string/lang_2"
                    android:textColor="@color/white"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/dp_10"
                    android:textSize="@dimen/sp_22"
                    android:layout_height="wrap_content">

                </TextView>

                <Spinner
                    android:layout_gravity="center_vertical"
                    android:id="@+id/spinner2"
                    android:layout_width="wrap_content"
                    android:outlineAmbientShadowColor="@color/white"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <EditText
                android:id="@+id/et_target"
                android:layout_width="match_parent"
                android:hint="@string/enter_text"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/dp_10"
                android:padding="@dimen/dp_10"
                android:gravity="left|top"
                android:background="@drawable/bg_background_edittext"
                android:layout_height="match_parent">

            </EditText>
        </LinearLayout>
    </LinearLayout>
</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>
