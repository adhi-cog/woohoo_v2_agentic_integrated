<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/news_headline_card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="@dimen/dp_24"
    android:layout_marginTop="@dimen/dp_16"
    android:layout_marginRight="@dimen/dp_24"
    android:elevation="@dimen/dp_5"
    app:cardBackgroundColor="@color/white_10_opacity"
    app:cardCornerRadius="@dimen/dp_5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="10">

        <ImageView
            android:id="@+id/news_headline_img"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_300"
            android:layout_weight="8"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/news_headline_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:maxLines="3"
            android:padding="@dimen/dp_24"
            android:text="Britain and EU Clear Way for Brexit Talks to Procceed"
            android:textColor="@android:color/white"
            android:textSize="@dimen/fragment_news_headline_text_view_size" />

    </LinearLayout>


</androidx.cardview.widget.CardView>
