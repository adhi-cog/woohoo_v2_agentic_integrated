<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timer_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    tools:context=".ui.main.fragments.timer.alert.TimerAlertFragment">

    <include layout="@layout/common_toolbar"
        android:id="@+id/fragment_common_toolbar"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/timer_done"
        android:layout_width="@dimen/dp_160"
        android:layout_height="@dimen/dp_160"
        android:layout_centerInParent="true"
        app:srcCompat="@drawable/ic_timer_done" />

    <TextView
        android:id="@+id/text_timer_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/timer_done"
        android:layout_centerInParent="true"
        android:layout_marginTop="@dimen/dp_32"
        android:text="@string/time_s_up"
        android:textColor="@android:color/white"
        android:textSize="@dimen/sp_37" />

    <TextView
        android:id="@+id/text_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_timer_done"
        android:layout_centerInParent="true"
        android:layout_marginTop="@dimen/dp_8"
        android:textColor="@android:color/white"
        android:textSize="@dimen/sp_19" />

    <Button
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_40"
        android:layout_marginBottom="@dimen/dp_32"
        android:padding="@dimen/dp_20"
        android:text="@string/done"
        android:textSize="@dimen/sp_20" />

</RelativeLayout>