<?xml version="1.0" encoding="utf-8"?>
<com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/background_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/turn_off_surveillance"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_40"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/surveillance_mode_on"
            android:textAlignment="viewStart"
            android:textAllCaps="false"
            android:textColor="@color/white_10_opacity"
            android:textSize="@dimen/sp_76"
            android:textStyle="bold" />

        <Button
            android:id="@+id/turn_off_surveillance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginTop="@dimen/dp_32"
            android:layout_marginEnd="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_53"
            android:background="@drawable/rounded_corner_dark_bg"
            android:gravity="center_horizontal"
            android:padding="@dimen/dp_24"
            android:text="@string/turn_off"
            android:textAllCaps="true"
            android:textColor="@color/white_10_opacity"
            android:textSize="@dimen/sp_20" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_surveillance_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B4000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="@dimen/dp_10"
            android:background="?color_secondary"
            android:padding="@dimen/dp_24">

            <TextView
                android:id="@+id/tv_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/turn_off_surveillance_desc"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_22" />


            <Button
                android:id="@+id/button_ok"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_question"
                android:layout_alignParentEnd="true"
                android:layout_marginLeft="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_15"
                android:background="@drawable/bg_cancel_button"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingLeft="@dimen/dp_24"
                android:paddingRight="@dimen/dp_24"
                android:text="@string/ok"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_21" />

            <Button
                android:id="@+id/button_cancel"
                android:layout_width="@dimen/dp_120"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_question"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_toStartOf="@id/button_ok"
                android:background="@drawable/bg_cancel_button"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:paddingLeft="@dimen/dp_24"
                android:paddingRight="@dimen/dp_24"
                android:text="@string/cancel"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_16"
                android:visibility="visible" />
        </RelativeLayout>

    </RelativeLayout>

</com.sb.woohoo.utils.ui.InputInterceptorRelativeLayout>