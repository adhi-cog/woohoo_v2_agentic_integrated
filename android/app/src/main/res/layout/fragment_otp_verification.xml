<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dining_restaurant"
    android:clickable="true"
    android:focusable="true">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/fragment_settings_relative_layout_header"
            layout="@layout/common_toolbar" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_below="@id/layout_toolbar"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edit_otp"
            style="@style/EditTextCentered"
            android:layout_marginBottom="@dimen/dp_24"
            android:background="@drawable/bg_stroke_edit_text"
            android:hint="@string/enter_otp"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLines="1"
            android:padding="@dimen/dp_26" />

        <TextView
            android:id="@+id/txt_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_25"
            android:text="Resend"
            android:clickable="false"
            android:enabled="false"
            android:textColor="@color/grey_restaurant_timing"
            />


        <TextView
            android:id="@+id/txt_email_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/sp_18"
            android:layout_marginTop="@dimen/dp_100"
            android:layout_marginBottom="@dimen/dp_24"
            android:textColor="@color/grey_restaurant_timing"
            android:text="Please check ‘example@email.com’ for OTP" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_53"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/dp_60"
            android:layout_marginEnd="@dimen/dp_60"
            android:layout_marginBottom="@dimen/dp_60"
            android:background="@drawable/btn_colored_bg"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/sp_26"
            android:textStyle="bold"
            android:visibility="visible" />
    </LinearLayout>

</RelativeLayout>