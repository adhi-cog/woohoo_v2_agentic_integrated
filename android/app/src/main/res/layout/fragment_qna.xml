<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_qna_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?color_secondary"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/fragment_qna_image_view_answer_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        android:contentDescription="@string/app_name" />

    <RelativeLayout
        android:id="@+id/fragment_qna_relative_layout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_toolbar_parent_margin_top"
        android:paddingStart="@dimen/common_toolbar_padding_start_end"
        android:paddingTop="@dimen/common_toolbar_padding_top_bottom"
        android:paddingEnd="@dimen/common_toolbar_padding_start_end"
        android:paddingBottom="@dimen/common_toolbar_padding_top_bottom">

        <ImageView
            android:id="@+id/fragment_qna_image_view_back"
            android:layout_width="@dimen/common_toolbar_back_width_height"
            android:layout_height="@dimen/common_toolbar_back_width_height"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:id="@+id/fragment_qna_text_view_question_qna"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_toolbar_title_margin_start_end"
            android:layout_marginEnd="@dimen/common_toolbar_title_margin_start_end"
            android:fontFamily="sans-serif-light"
            android:textColor="@android:color/white"
            android:textSize="@dimen/common_toolbar_title_text_size" />

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fragment_qna_relative_layout_toolbar"
        android:layout_margin="@dimen/fragment_qna_linear_view_answer_margin"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <TextView
                android:id="@+id/fragment_qna_text_view_answer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:padding="@dimen/fragment_qna_text_view_answer_text_padding"
                android:textAlignment="textStart"
                android:textColor="@android:color/white"
                android:textSize="@dimen/fragment_qna_text_view_answer_text_size" />

        </ScrollView>

    </RelativeLayout>

    <ProgressBar
        android:id="@+id/fragment_qna_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>