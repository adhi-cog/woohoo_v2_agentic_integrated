// Template for app/src/main/res/raw/credential.json (Google Cloud Speech service account).
// That path is gitignored. The key previously committed there shipped inside every APK and
// must be treated as compromised: rotate it, and prefer minting short-lived tokens from a
// backend over bundling a service-account key in a client at all.
{
  "type": "service_account",
  "project_id": "<your-gcp-project>",
  "private_key_id": "<rotate-the-leaked-key-first>",
  "private_key": "-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----\n",
  "client_email": "<service-account>@<project>.iam.gserviceaccount.com",
  "client_id": "<id>",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "<cert-url>",
  "universe_domain": "googleapis.com"
}
