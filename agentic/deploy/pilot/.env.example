# Pilot host secrets. NOT committed (.gitignore: .env, .env.*). Mode 600 on the server.

# Required on x-pilot-key for /v1/turn and the ack route. Read by bootstrap.sh and baked
# into the nginx config; never passed into the container.
PILOT_KEY=replace-with-openssl-rand-hex-24

# Guards /v1/admin/rooms and /v1/admin/stays/checkout. Pinned so a restart does not
# invalidate the provisioning commands in the runbook.
WOOHOO_ADMIN_TOKEN=replace-with-openssl-rand-hex-24

# Bearer for the domain event stream.
WOOHOO_EVENT_TOKEN=replace-with-openssl-rand-hex-24

# Without this the agentic lane runs on the deterministic mock provider, which answers
# the scripted phrases and nothing else - the pilot would not be exercising the real
# routing. This key came from agentic/deploy.sh; it is a live Google API key and should be
# restricted to the Generative Language API and rotated when the pilot ends.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=20

# Device identity stays off: enforcing it requires a TLS terminator doing client
# certificate verification, and no certificate has been provisioned into the hub. See
# README "What this does not protect against".
WOOHOO_REQUIRE_DEVICE_AUTH=
